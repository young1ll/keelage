{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "keelage hook claude-code SessionStart", "timeout": 2 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "keelage hook claude-code UserPromptSubmit", "timeout": 2 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [ { "type": "command", "command": "keelage hook claude-code PreToolUse", "timeout": 2 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [ { "type": "command", "command": "keelage hook claude-code PostToolUse", "timeout": 2 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "keelage hook claude-code SessionEnd", "timeout": 2 } ] }
    ]
  }
}
