{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/young1ll/keelage/spec/schema/rejected.json",
  "$ref": "#/$defs/Rejected",
  "$defs": {
    "ActorRef": {
      "properties": {
        "kind": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "description": "Key is the signing key fingerprint."
        },
        "owner": {
          "type": "string",
          "description": "Owner is the responsible human for an agent instance. Required for agents."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "description": "ActorRef identifies who acted."
    },
    "Rejected": {
      "properties": {
        "command": {
          "type": "string"
        },
        "target": {
          "type": "string",
          "description": "the aggregate stream the command addressed"
        },
        "code": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "actor": {
          "$ref": "#/$defs/ActorRef"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "command",
        "target",
        "code",
        "reason",
        "actor"
      ],
      "description": "Rejected records a refused command (spec §3.6c): conflicts are kept, not dropped."
    }
  }
}
