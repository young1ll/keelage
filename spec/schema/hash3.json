{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/young1ll/keelage/spec/schema/hash3.json",
  "$ref": "#/$defs/Hash3",
  "$defs": {
    "Hash3": {
      "properties": {
        "signature": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "file": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "signature",
        "body",
        "file"
      ],
      "description": "Hash3 is the three-layer anchor hash (spec §1 \"낡음 판정\"): signature, body, file."
    }
  }
}
