{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/young1ll/keelage/spec/schema/events/AnchorVerified.v1.json",
  "$ref": "#/$defs/AnchorVerified",
  "$defs": {
    "AnchorVerified": {
      "properties": {
        "key": {
          "type": "string"
        },
        "hash": {
          "$ref": "#/$defs/Hash3"
        },
        "change": {
          "type": "integer"
        },
        "ref": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "key",
        "hash",
        "change",
        "at"
      ],
      "description": "AnchorVerified: the hash still matches (or only the file layer moved)."
    },
    "Hash3": {
      "properties": {
        "signature": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "file": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "signature",
        "body",
        "file"
      ],
      "description": "Hash3 is the three-layer anchor hash (spec §1 \"낡음 판정\"): signature, body, file."
    }
  }
}
