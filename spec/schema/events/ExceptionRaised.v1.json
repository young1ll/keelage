{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/young1ll/keelage/spec/schema/events/ExceptionRaised.v1.json",
  "$ref": "#/$defs/ExceptionRaised",
  "$defs": {
    "ExceptionRaised": {
      "properties": {
        "key": {
          "$ref": "#/$defs/ScopeKey"
        },
        "category": {
          "type": "string"
        },
        "change_ref": {
          "type": "string"
        },
        "level": {
          "type": "string",
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "key",
        "category",
        "level",
        "at"
      ],
      "description": "ExceptionRaised records a regression that needs a human."
    },
    "ScopeKey": {
      "properties": {
        "org": {
          "type": "string"
        },
        "product": {
          "type": "string"
        },
        "team": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "person": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "ScopeKey is a coordinate in the scope lattice (ADR 0006): org × product × team × (repo, path glob) × person."
    }
  }
}
