{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/young1ll/keelage/spec/schema/events/DecisionRevised.v1.json",
  "$ref": "#/$defs/DecisionRevised",
  "$defs": {
    "ActorRef": {
      "properties": {
        "kind": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "description": "Key is the signing key fingerprint."
        },
        "owner": {
          "type": "string",
          "description": "Owner is the responsible human for an agent instance. Required for agents."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "description": "ActorRef identifies who acted."
    },
    "DecisionRevised": {
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "by": {
          "$ref": "#/$defs/ActorRef"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "title",
        "body",
        "by",
        "at"
      ],
      "description": "DecisionRevised replaces the text; state falls back to generated until re-verified."
    }
  }
}
