{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/young1ll/keelage/spec/schema/events/AnchorStaled.v1.json",
  "$ref": "#/$defs/AnchorStaled",
  "$defs": {
    "AnchorStaled": {
      "properties": {
        "key": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "cause": {
          "type": "integer"
        },
        "old": {
          "$ref": "#/$defs/Hash3"
        },
        "new": {
          "$ref": "#/$defs/Hash3"
        },
        "ref": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "key",
        "state",
        "cause",
        "old",
        "new",
        "at"
      ],
      "description": "AnchorStaled: the body (review) or the signature (stale) changed, or the anchor is gone (unrealized)."
    },
    "Hash3": {
      "properties": {
        "signature": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "file": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "signature",
        "body",
        "file"
      ],
      "description": "Hash3 is the three-layer anchor hash (spec §1 \"낡음 판정\"): signature, body, file."
    }
  }
}
