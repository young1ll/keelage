{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/young1ll/keelage/spec/schema/events/AnchorRecorded.v1.json",
  "$ref": "#/$defs/AnchorRecorded",
  "$defs": {
    "ActorRef": {
      "properties": {
        "kind": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "description": "Key is the signing key fingerprint."
        },
        "owner": {
          "type": "string",
          "description": "Owner is the responsible human for an agent instance. Required for agents."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "description": "ActorRef identifies who acted."
    },
    "AnchorRecorded": {
      "properties": {
        "key": {
          "type": "string"
        },
        "hash": {
          "$ref": "#/$defs/Hash3"
        },
        "ref": {
          "type": "string"
        },
        "by": {
          "$ref": "#/$defs/ActorRef"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "key",
        "hash",
        "by",
        "at"
      ],
      "description": "AnchorRecorded is the baseline event."
    },
    "Hash3": {
      "properties": {
        "signature": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "file": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "signature",
        "body",
        "file"
      ],
      "description": "Hash3 is the three-layer anchor hash (spec §1 \"낡음 판정\"): signature, body, file."
    }
  }
}
