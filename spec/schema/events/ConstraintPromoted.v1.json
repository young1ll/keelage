{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/young1ll/keelage/spec/schema/events/ConstraintPromoted.v1.json",
  "$ref": "#/$defs/ConstraintPromoted",
  "$defs": {
    "ActorRef": {
      "properties": {
        "kind": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "description": "Key is the signing key fingerprint."
        },
        "owner": {
          "type": "string",
          "description": "Owner is the responsible human for an agent instance. Required for agents."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "description": "ActorRef identifies who acted."
    },
    "ConstraintPromoted": {
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "$ref": "#/$defs/ScopeKey"
        },
        "to": {
          "$ref": "#/$defs/ScopeKey"
        },
        "origin": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "explanation": {
          "type": "string"
        },
        "by": {
          "$ref": "#/$defs/ActorRef"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "origin",
        "explanation",
        "by",
        "at"
      ],
      "description": "ConstraintPromoted widens scope; carries the source judgments and explanation."
    },
    "ScopeKey": {
      "properties": {
        "org": {
          "type": "string"
        },
        "product": {
          "type": "string"
        },
        "team": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "person": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "ScopeKey is a coordinate in the scope lattice (ADR 0006): org × product × team × (repo, path glob) × person."
    }
  }
}
