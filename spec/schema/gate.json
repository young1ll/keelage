{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/young1ll/keelage/spec/schema/gate.json",
  "$ref": "#/$defs/Gate",
  "$defs": {
    "ActorRef": {
      "properties": {
        "kind": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "description": "Key is the signing key fingerprint."
        },
        "owner": {
          "type": "string",
          "description": "Owner is the responsible human for an agent instance. Required for agents."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "description": "ActorRef identifies who acted."
    },
    "Gate": {
      "properties": {
        "id": {
          "type": "string"
        },
        "actor": {
          "$ref": "#/$defs/ActorRef"
        },
        "scope": {
          "$ref": "#/$defs/ScopeKey"
        },
        "anchors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "action": {
          "type": "string"
        },
        "proposal_ref": {
          "type": "string"
        },
        "requested_level": {
          "type": "string",
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3"
          ]
        },
        "decision": {
          "type": "string"
        },
        "policy_ref": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "opened_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "resolution": {
          "$ref": "#/$defs/Resolution"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "actor",
        "scope",
        "proposal_ref",
        "requested_level",
        "decision",
        "policy_ref",
        "state",
        "opened_at"
      ],
      "description": "Gate is the approval broker record (spec §3.6a, ADR 0005): an agent asks before acting; policy answers allow/deny/ask from the autonomy level, cap and ownership; a human resolves \"ask\" in their own channel; the answer is recorded as a judgment and feeds promotion."
    },
    "Resolution": {
      "properties": {
        "decision": {
          "type": "string",
          "description": "allow | deny"
        },
        "reason": {
          "type": "string"
        },
        "by": {
          "$ref": "#/$defs/ActorRef"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "sig": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "decision",
        "reason",
        "by",
        "at"
      ],
      "description": "Resolution is a human's answer to an open gate, from any channel."
    },
    "ScopeKey": {
      "properties": {
        "org": {
          "type": "string"
        },
        "product": {
          "type": "string"
        },
        "team": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "person": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "ScopeKey is a coordinate in the scope lattice (ADR 0006): org × product × team × (repo, path glob) × person."
    }
  }
}
